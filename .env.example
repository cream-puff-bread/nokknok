# ─── Database ───
# ⚠️ 반드시 풀링(Pooled) 주소를 사용할 것. Direct 주소는 무료 티어 연결 한도를 초과시킨다.
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/nokknok?sslmode=require
DB_POOL_MAX=5

# ─── LLM ───
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRY=5

# ─── App ───
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
