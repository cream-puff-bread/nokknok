# ═══════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════
# ⚠️ 반드시 풀링(Pooled) 주소를 사용할 것.
#    Direct 주소는 무료 티어 동시 연결 한도를 금방 초과시킨다.
#    Neon: 호스트에 '-pooler' 가 포함된 엔드포인트
#    Supabase: Supavisor 풀러 주소 (포트 6543)
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/nokknok?sslmode=require

# 애플리케이션 측 커넥션 풀 상한. 무료 티어에서는 5 내외를 권장한다.
DB_POOL_MAX=5
DB_POOL_TIMEOUT_S=10

# ═══════════════════════════════════════════════
# LLM
# ═══════════════════════════════════════════════
# Gemini (Google AI Studio). 발급: https://aistudio.google.com/apikey
# ⚠️ 무료 티어는 입출력이 모델 개선에 사용될 수 있다.
#    가상 페르소나와 공개 약관만 전송하므로 현 단계에서는 문제없으나,
#    실제 이용자가 업로드한 명세서는 절대 이 키로 보내지 않는다.
# docs/decisions/002 에서 Gemini로 확정했다.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# ─── 배치 경로 (약관 변환) ───
# 사용자가 기다리지 않으므로 넉넉히 잡는다.
# 실패 시 처리 완료 목록을 파일로 남겨 중단 지점부터 재개한다.
LLM_BATCH_TIMEOUT_MS=15000
LLM_BATCH_MAX_RETRY=5

# ─── 런타임 경로 (질의 해석, 결과 설명) ───
# 동기 응답이므로 총 소요 시간에 예산을 건다.
# 재시도 횟수가 아니라 이 예산이 응답 시간을 결정한다.
# 예산 초과 시 재시도 중이라도 포기하고 explanation=null 로 응답한다.
# 재시도 횟수 설정은 두지 않는다. stop_after_delay 는 예산만 보므로
# 횟수 값을 두면 실제 효과는 없는데 바꾸면 동작이 달라진다고 오해하게 된다.
LLM_RUNTIME_TIMEOUT_BUDGET_MS=3500

# ═══════════════════════════════════════════════
# App
# ═══════════════════════════════════════════════
PORT=8000
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
